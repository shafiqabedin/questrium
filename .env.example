# Copy to .env.local and fill in. Never commit .env.local.
# Both of these are safe to expose in a browser bundle: the anon key's access is
# bounded by Row Level Security policies, not by secrecy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The service-role key bypasses Row Level Security. It must never appear in a
# VITE_ variable or anywhere in frontend code — server-side and local tooling only.
